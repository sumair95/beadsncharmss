# Cache policy is resolved here rather than with per-location add_header,
# because an add_header inside a location block cancels *every* add_header
# inherited from the server block — which would strip the security headers
# below from exactly the pages that need them. Exact matches win over regexes.
map $uri $cache_control {
    default                                      "public, max-age=3600";
    ~*\.(jpg|jpeg|png|gif|svg|webp|ico|woff2?)$  "public, max-age=2592000, immutable";
    /index.html                                  "no-cache, must-revalidate";
}

# www -> apex. Both domains point at this one service, so without this they
# would serve identical content under two hostnames. The catch-all server
# below stays the default, so Railway's own *.up.railway.app domain and the
# health check are unaffected.
server {
    listen      ${PORT};
    server_name www.beadsncharmss.com;
    return 301  https://beadsncharmss.com$request_uri;
}

server {
    listen       ${PORT} default_server;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # ── Compression ────────────────────────────────────────────
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/xml application/javascript
                      application/json image/svg+xml;

    # ── Caching ────────────────────────────────────────────────
    # index.html is never cached, so a redeploy reaches returning visitors
    # immediately. Static assets get a long TTL.
    add_header Cache-Control $cache_control always;

    # ── Security headers ───────────────────────────────────────
    add_header X-Content-Type-Options   "nosniff"            always;
    add_header X-Frame-Options          "DENY"               always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=()" always;

    # The store is one inline-script HTML file talking to Supabase over REST,
    # so 'unsafe-inline' is required for scripts/styles. connect-src and img-src
    # stay locked to Supabase + Google Fonts, which limits what injected markup
    # could ever reach.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https://kjwhxuqbrcerqfuikcmv.supabase.co; connect-src https://kjwhxuqbrcerqfuikcmv.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ── Never serve config, schema or dotfiles ─────────────────
    # Defence in depth. .dockerignore and the Dockerfile already try to keep
    # these out of the web root, but a build that fails to remove one must not
    # turn into a disclosure. Regex locations are matched before the prefix
    # location below, so these win.
    location ~* \.(template|conf|sql|md|ya?ml|toml|ini|bak|log|env)$ {
        return 404;
    }
    location ~ /\. {
        return 404;
    }

    # ── Routing ────────────────────────────────────────────────
    # Single-page app: unknown paths fall back to the store shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Railway health check
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
}
